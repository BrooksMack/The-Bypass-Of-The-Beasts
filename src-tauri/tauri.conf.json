{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VM Setup Assistant",
  "version": "../package.json",
  "identifier": "org.vm-setup-assistant.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VM Setup Assistant",
        "label": "main",
        "width": 960,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Sets up a Windows 11 virtual machine with Oracle VirtualBox",
    "longDescription": "VM Setup Assistant checks your computer, helps you get the official VirtualBox installer and Windows 11 installation media, creates a sensibly configured virtual machine and guides you through Windows Setup. It does not include Windows or VirtualBox.",
    "copyright": "MIT License. Windows and VirtualBox are separate products with their own licenses.",
    "licenseFile": "../LICENSE",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  },
  "plugins": {}
}
